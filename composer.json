{
    "name": "mst/mst-reloadtrigger",
    "description": "add a trigger where e.g. browsersync can watch",
    "type": "typo3-cms-extension",
    "license": "proprietary",
    "require": {
        "php": ">=8.2 <8.6",
        "typo3/cms-core": "12.4.* || 13.4.* || 14.3.*"
    },
    "autoload": {
        "psr-4": {
            "MST\\MstReloadtrigger\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mst_reloadtrigger"
        }
    }
}
